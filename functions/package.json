    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": "18"
  },
  "main": "lib/index.js",
  "dependencies": {
    "cors": "^2.8.5",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.0",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "~5.7.2"
  },
  "private": true
}
